# Copy this file to .env and fill in the values you need.
# .env is gitignored. Never commit real credentials.

# Option A (recommended): refresh token only, so your password is never stored.
# Get one by running `npm start -- --print-refresh-token` once with option B.
# When this is set, STEAM_ACCOUNT_NAME and STEAM_PASSWORD are ignored.
STEAM_REFRESH_TOKEN=

# Option B: account name and password.
# Leave either empty to be prompted at startup (the password prompt is hidden).
STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=

# How long to stay connected to the CS2 Game Coordinator, in seconds (default: 25).
IDLE_SECONDS=25
